# Conflux AI — Production Environment Configuration
# Copy this file to .env and supply your live credentials from the Supabase and Resend dashboards.

# 1. Supabase Backend-as-a-Service (PostgreSQL 15+ & Auth)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server-side Supabase Service Role Key (For backend serverless functions in Vercel)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Transactional Inbound Lead Emailing (Resend API)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
LEAD_NOTIFICATION_EMAIL=contact@confluxai.in

# 4. Google Customer Reviews (Official Google Maps Platform Places API)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
# Enable "Places API" (or Places API New) in Google Cloud Console
# Set as server-side environment variable in Vercel / server hosting:
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesApiKeyHere

# 5. Cashfree Payment Gateway (Paid Conflux Verified Applications — ₹499 First Year)
# Obtain credentials from: https://merchant.cashfree.com/merchants/pg/developers/api-keys
# Server-side ONLY: Never expose CASHFREE_SECRET_KEY in client bundle (no VITE_ prefix).
CASHFREE_APP_ID=TEST100000000000000000000000000000
CASHFREE_SECRET_KEY=TEST0000000000000000000000000000000000000000
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
APP_URL=https://www.confluxai.in

